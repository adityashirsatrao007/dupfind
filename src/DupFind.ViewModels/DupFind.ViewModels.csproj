<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation logic that needs no UI framework. Kept off net8.0-windows so the rules
    below (KeepNewest, group resolution, header text) can be tested on any machine —
    a WPF test needs a Windows desktop session, an INotifyPropertyChanged test does not.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DupFind.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DupFind.Core\DupFind.Core.csproj" />
  </ItemGroup>

</Project>
