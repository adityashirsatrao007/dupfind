<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DupFind</AssemblyName>
    <RootNamespace>DupFind.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>DupFind</Product>
    <Description>Duplicate file finder for Windows with size-first SHA-256 detection.</Description>
  </PropertyGroup>

  <!-- Lets contributors on Linux/macOS restore and compile the solution. No effect on Windows. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DupFind.Core\DupFind.Core.csproj" />
  </ItemGroup>

</Project>
