<Window x:Class="DupFind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DupFind — duplicate file finder"
        Height="760" Width="1120"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folders to scan -->
        <GroupBox Grid.Row="0" Header="Folders to scan" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Height="104"
                         ItemsSource="{Binding Folders}"
                         SelectedItem="{Binding SelectedFolder}" />

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Button Content="Add folder…"
                            Command="{Binding AddFolderCommand}"
                            Padding="10,5" Margin="0,0,0,6" />
                    <Button Content="Remove"
                            Command="{Binding RemoveFolderCommand}"
                            Padding="10,5" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Scan"
                    Command="{Binding ScanCommand}"
                    Padding="18,6" FontWeight="SemiBold" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="14,6" Margin="6,0,0,0" />
            <Separator Margin="10,4" />
            <Button Content="Keep newest in each group"
                    Command="{Binding KeepNewestCommand}"
                    Padding="12,6" ToolTip="Selects every copy except the most recently modified file in each group." />
            <Button Content="Deselect all"
                    Command="{Binding ClearSelectionCommand}"
                    Padding="12,6" Margin="6,0,0,0" />
            <Button Content="Move selected…"
                    Command="{Binding MoveSelectedCommand}"
                    Padding="12,6" Margin="6,0,0,0"
                    ToolTip="Moves the ticked files into a folder you choose. Nothing is deleted permanently." />
            <Button Content="Export CSV…"
                    Command="{Binding ExportCsvCommand}"
                    Padding="12,6" Margin="6,0,0,0" />
            <Button Content="Skipped files…"
                    Command="{Binding ShowSkippedCommand}"
                    Padding="12,6" Margin="6,0,0,0"
                    ToolTip="Files and folders the scan could not read." />
        </StackPanel>

        <!-- Progress -->
        <ProgressBar Grid.Row="2"
                     Height="6" Margin="0,12,0,0"
                     Minimum="0" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Header row for results -->
        <DockPanel Grid.Row="3" Margin="0,12,0,4">
            <TextBlock Text="Duplicate groups"
                       FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding SelectionText}"
                       DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       Opacity="0.75" />
        </DockPanel>

        <!--
            Results. This is a ListBox rather than an ItemsControl inside a ScrollViewer,
            because only a virtualizing panel recycles containers. The old markup built one
            TextBlock and one CheckBox per file — 200 000 controls for a 100 000-file scan —
            and the window stopped responding while it laid them out.
        -->
        <Border Grid.Row="4" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Padding="10">
            <ListBox ItemsSource="{Binding Groups}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <!-- Ticking is done with checkboxes, so the row container carries no
                         chrome and no selection highlight of its own. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,4"
                                  Header="{Binding Header}"
                                  IsExpanded="True">
                            <!-- shortcut: a single group holding thousands of copies is not
                                 virtualized at this level; upgrade to a grouped
                                 CollectionView with IsVirtualizingWhenGrouping if that shows up. -->
                            <ItemsControl ItemsSource="{Binding Files}" Margin="24,4,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding FileName}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Path}"
                                                       ToolTip="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LastModified}"
                                                       Opacity="0.6"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="5"
                   Text="{Binding Status}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.85" />
    </Grid>
</Window>
